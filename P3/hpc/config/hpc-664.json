{
  "schema": "qflpn-p3-hpc-configuration",
  "schema_version": "1.0.0",
  "configuration_id": "P3-HPC-664-REFERENCE",
  "configuration_status": "PROPOSED_NOT_HARDWARE_VERIFIED",

  "project": {
    "name": "QFLPN",
    "component": "P3",
    "description": "Sparse Quantum-Fuzzy Logical Petri Nets: CSR/SpMV Algorithms and Large-Scale State Evolution",
    "matrix_format": "CSR",
    "operation": "y = A * x",
    "matrix_semantics": {
      "N": "number_of_states_and_matrix_rows",
      "M": "number_of_matrix_columns",
      "NNZ": "number_of_stored_nonzero_entries",
      "qubit_count_is_N": false
    }
  },

  "acceptance": {
    "central_workflow": "p3_validation",
    "required": true,
    "p1_modification_allowed": false,
    "final_verdict": "P3_ACCEPTED",
    "fail_closed": true,
    "require_same_commit": true,
    "require_same_run_id": true,
    "require_manifest": true,
    "require_sha256_checksums": true,
    "require_independent_integrity_verification": true,
    "unmeasured_performance_may_pass": false,
    "missing_data_may_pass": false,
    "hpc_not_executed_status": "NOT_EVALUATED"
  },

  "hardware_reference": {
    "verification_status": "NOT_VERIFIED",
    "compute_nodes": 16,
    "physical_cores_total": 664,
    "memory_total_gib": 4096,
    "memory_total_tib": 4,
    "memory_per_node_gib": 256,

    "node_groups": [
      {
        "group_id": "NODE_GROUP_42",
        "node_count": 8,
        "physical_cores_per_node": 42,
        "total_physical_cores": 336,
        "memory_per_node_gib": 256
      },
      {
        "group_id": "NODE_GROUP_41",
        "node_count": 8,
        "physical_cores_per_node": 41,
        "total_physical_cores": 328,
        "memory_per_node_gib": 256
      }
    ],

    "processor": {
      "target_family": "AMD EPYC 9005 or equivalent",
      "exact_model": "UNSPECIFIED",
      "physical_core_count_must_be_verified": true,
      "socket_count": "DISCOVER_AT_PREFLIGHT",
      "smt_enabled": "DISCOVER_AT_PREFLIGHT"
    },

    "memory": {
      "type": "ECC",
      "capacity_per_node_gib": 256,
      "numa_topology": "DISCOVER_AT_PREFLIGHT",
      "memory_bandwidth": "MEASURE_ON_HARDWARE"
    },

    "storage": {
      "target": "2 x enterprise NVMe per compute node",
      "exact_model": "UNSPECIFIED"
    },

    "network": {
      "target": "InfiniBand NDR 400 Gb/s or equivalent",
      "exact_adapter": "UNSPECIFIED",
      "measured_bandwidth_required": true,
      "measured_latency_required": true
    }
  },

  "software_reference": {
    "operating_system": "Linux",
    "java_version": 21,
    "build_system": "Maven",
    "scheduler": "Slurm",
    "distributed_communication": "MPI",
    "mpi_implementation": "UNSELECTED",
    "mpi_version": "DISCOVER_AT_PREFLIGHT",
    "maven_version": "RECORD_AT_RUNTIME",
    "kernel_version": "RECORD_AT_RUNTIME"
  },

  "execution_models": {
    "intra_node": {
      "enabled": true,
      "strategies": [
        "SEQ",
        "FJ_PLAN",
        "STATIC"
      ],
      "runtime": "Java ForkJoinPool",
      "memory_model": "SHARED_MEMORY"
    },

    "inter_node": {
      "enabled": true,
      "implementation_status": "NOT_IMPLEMENTED",
      "runtime": "MPI",
      "memory_model": "DISTRIBUTED_MEMORY",
      "strategies": [
        "MPI_CSR_ROW_PARTITION"
      ],
      "communication_measurement_required": true
    }
  },

  "csr": {
    "index_type": "int32",
    "value_type": "float64",
    "row_pointer_type": "int32",
    "canonical_columns": true,
    "fixed_row_accumulation_order": true,
    "duplicate_entries_policy": "AGGREGATE_DURING_NORMALIZATION",
    "input_arrays_must_be_validated": true,
    "integer_index_capacity_must_be_checked": true
  },

  "benchmark": {
    "run_id_source": "p3_validation",
    "source_commit_required": true,
    "environment_inventory_required": true,
    "raw_measurements_required": true,
    "randomized_strategy_order": true,

    "dimensions": {
      "smoke": [
        1000000
      ],
      "calibration": [
        1000000,
        10000000
      ],
      "extended": [
        10000000,
        30000000
      ],
      "hpc": [
        70000000,
        100000000
      ]
    },

    "workloads": [
      "UNIFORM_2",
      "POWERLAW",
      "DIAGONAL",
      "BANDED",
      "EMPTY_ROWS",
      "SKEWED_ROWS",
      "HEAVY_ROW",
      "QFLPN_REAL"
    ],

    "strategies": [
      "SEQ",
      "FJ_PLAN",
      "STATIC"
    ],

    "parallelism": [
      1,
      2,
      4,
      8,
      16,
      32,
      64,
      128,
      256,
      512,
      640,
      664
    ],

    "oversubscription_diagnostics": [
      672
    ],

    "thresholds": [
      256,
      512,
      1024,
      2048,
      4096,
      8192,
      16384
    ],

    "sampling": {
      "minimum_forks": 5,
      "warmup_iterations_per_fork": 10,
      "timed_iterations_per_fork": 10,
      "minimum_timed_samples_per_configuration": 30,
      "target_timed_samples_per_configuration": 50,
      "independent_jvm_per_fork": true
    },

    "execution_phases": [
      {
        "phase": "SMOKE",
        "purpose": "Correctness and execution overhead",
        "dimensions": [
          1000000
        ],
        "parallelism": [
          1,
          2,
          4
        ],
        "thresholds": [
          4096
        ]
      },
      {
        "phase": "THRESHOLD_CALIBRATION",
        "purpose": "Measure task granularity and select candidate thresholds",
        "dimensions": [
          1000000,
          10000000
        ],
        "parallelism": [
          1,
          2,
          4
        ],
        "thresholds": [
          256,
          512,
          1024,
          2048,
          4096,
          8192,
          16384
        ]
      },
      {
        "phase": "INTRA_NODE_SCALING",
        "purpose": "Measure shared-memory strong scaling",
        "dimensions": [
          10000000,
          30000000
        ],
        "parallelism": [
          1,
          2,
          4,
          8,
          16,
          32,
          64
        ],
        "threshold_selection": "USE_CALIBRATED_THRESHOLDS"
      },
      {
        "phase": "HPC_SCALING",
        "purpose": "Measure distributed strong and weak scaling",
        "dimensions": [
          10000000,
          30000000,
          70000000,
          100000000
        ],
        "parallelism": [
          64,
          128,
          256,
          512,
          640,
          664
        ],
        "threshold_selection": "USE_CALIBRATED_THRESHOLDS",
        "requires_mpi": true,
        "requires_slurm": true,
        "requires_verified_hardware": true
      }
    ]
  },

  "performance_metrics": {
    "required": [
      "elapsed_time_ms",
      "setup_time_ms",
      "speedup",
      "parallel_efficiency",
      "nnz_per_second",
      "flops_per_second",
      "load_imbalance",
      "task_scheduling_overhead",
      "synchronization_time",
      "peak_memory_bytes",
      "garbage_collection_time",
      "modeled_effective_gbs"
    ],

    "hardware_counters": {
      "required_for_measured_roofline": true,
      "dram_read_bytes": "MEASURE_IF_SUPPORTED",
      "dram_write_bytes": "MEASURE_IF_SUPPORTED",
      "cache_misses": "MEASURE_IF_SUPPORTED",
      "memory_stalls": "MEASURE_IF_SUPPORTED"
    },

    "bandwidth": {
      "modeled_bandwidth_label": "MODELED_EFFECTIVE_GBS",
      "hardware_bandwidth_label": "MEASURED_DRAM_GBS",
      "must_not_conflate_modeled_and_measured": true,
      "stream_benchmark": "STANDARD_STREAM_OR_EXPLICITLY_NAMED_CUSTOM_TRIAD"
    }
  },

  "statistics": {
    "confidence_level": 0.95,
    "bootstrap_resamples": 10000,
    "bootstrap_method": "HIERARCHICAL_FORK_THEN_ITERATION",
    "paired_speedup_required": true,
    "report_median": true,
    "report_mean": true,
    "report_standard_deviation": true,
    "report_iqr": true,
    "report_mad": true,
    "report_sample_count": true,
    "report_fork_count": true,
    "empty_samples_status": "FAIL",
    "insufficient_samples_status": "FAIL",
    "not_evaluable_status": "NOT_EVALUATED"
  },

  "numerical_validation": {
    "reference_strategy": "SEQ",
    "intra_node_bitwise_comparison": true,
    "mpi_comparison": "DOCUMENTED_NUMERICAL_TOLERANCE",
    "absolute_error_required": true,
    "relative_error_required": true,
    "nan_policy": "REJECT_INPUT",
    "infinity_policy": "REJECT_INPUT",
    "overflow_detection_required": true,
    "deterministic_input_seed_required": true
  },

  "memory_model": {
    "csr_payload_bytes": "16 * NNZ + 4 * (N + 1)",
    "vector_payload_bytes": "8 * N + 8 * N",
    "modeled_spmv_traffic_bytes": "12 * NNZ + 4 * (N + 1) + 16 * N",
    "model_excludes_runtime_overhead": true,
    "model_is_not_hardware_dram_measurement": true,
    "preflight_required_before_large_allocations": true
  },

  "hpc_partitioning": {
    "intra_node": [
      "ROW_BOUNDARY_SCAN",
      "BINARY_NNZ_SPLIT",
      "STATIC_NNZ_CHUNK"
    ],
    "inter_node": [
      "CONTIGUOUS_CSR_ROW_PARTITION",
      "DISTRIBUTED_VECTOR_POLICY"
    ],
    "distributed_vector_policy": "MUST_BE_SELECTED_AND_DOCUMENTED",
    "single_heavy_row_policy": "MUST_BE_TESTED",
    "load_balance_metrics_required": true
  },

  "slurm": {
    "preflight_required": true,
    "job_accounting_required": true,
    "allocation_must_be_verified": true,
    "cpu_binding_must_be_recorded": true,
    "memory_binding_must_be_recorded": true,
    "scripts": [
      "P3/hpc/slurm/p3-hpc-preflight.sbatch",
      "P3/hpc/slurm/p3-hpc-benchmark.sbatch",
      "P3/hpc/slurm/p3-hpc-validate.sbatch"
    ]
  },

  "required_artifacts": [
    "benchmark.csv",
    "benchmark.json",
    "worker_metrics.csv",
    "cluster_inventory.json",
    "node_inventory.json",
    "confidence_intervals.json",
    "scaling_analysis.json",
    "load_balance.json",
    "HPC_REPORT.md",
    "HPC_REPORT.txt",
    "HPC_SUMMARY.json",
    "MANIFEST.txt",
    "SHA256SUMS.txt"
  ],

  "integration": {
    "central_workflow": ".github/workflows/p3-validation.yml",
    "central_job": "p3_validation",
    "hpc_results_must_be_validated_by_central_workflow": true,
    "existing_v2_validation_must_be_preserved": true,
    "existing_v3_validation_must_be_preserved": true,
    "existing_integrity_chain_must_be_preserved": true,
    "hpc_not_run_must_not_be_reported_as_pass": true,
    "p3_acceptance_requires_same_commit_and_run_identity": true
  },

  "provenance": {
    "source_commit_required": true,
    "workflow_run_id_required": true,
    "run_id_required": true,
    "hardware_inventory_required": true,
    "software_versions_required": true,
    "configuration_hash_required": true,
    "raw_data_immutable": true,
    "reproduction_must_not_checkout_in_users_working_tree": true
  }
}
